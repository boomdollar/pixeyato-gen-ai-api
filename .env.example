# Salin ke .env pada server. Jangan masukkan file .env ke APK atau kirim ke orang lain.
# API key aplikasi Anda sendiri (opsional di development, wajib di production)
PIXEYATO_API_KEY=ganti_dengan_kunci_panjang_acak

# Kunci penyedia AI untuk generasi gambar. Diperlukan untuk /v1/images/generate.
OPENAI_API_KEY=

# Default endpoint dan model; sesuaikan dengan akses akun penyedia AI.
OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

MAX_UPLOAD_MB=12
STORAGE_DIR=storage
